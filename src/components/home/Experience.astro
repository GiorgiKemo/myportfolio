---
import { experience, credentials } from '../../data/career';
---

<section id="experience" class="xp" aria-labelledby="xp-title">
  <div class="wrap">
    <p class="kicker">Background</p>
    <h2 id="xp-title" class="xp-title">Experience <span class="serif">&amp; certificates.</span></h2>

    <div class="xp-grid">
      <div>
        <h3 class="xp-sub mono">Work experience</h3>
        <ol class="xp-list">
          {experience.map((e) => (
            <li class="reveal">
              <p class="xp-meta mono">{e.dates}</p>
              <h4>{e.role}</h4>
              <p class="xp-company">{e.company}</p>
              <p class="xp-text">{e.summary}</p>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <h3 class="xp-sub mono">Certificates and education</h3>
        <ul class="xp-list">
          {credentials.map((c) => (
            <li class="reveal">
              <p class="xp-meta mono">{c.date}</p>
              <h4>{c.name}</h4>
              <p class="xp-company">{c.issuer}</p>
              {c.id && <p class="xp-id mono">Credential ID {c.id}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .xp { padding: clamp(96px, 12vw, 180px) 0 clamp(64px, 8vw, 100px); }
  .xp-title { font-size: clamp(38px, 5.4vw, 88px); letter-spacing: -0.06em; line-height: 0.94; margin: 22px 0 clamp(40px, 6vw, 72px); }
  .xp-title .serif { color: var(--muted); }
  .xp-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 120px); }
  .xp-sub { font-size: 12px; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); padding-bottom: 14px; }
  .xp-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-2); }
  .xp-list li { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .xp-list h4 { font-size: clamp(20px, 1.8vw, 26px); font-weight: 560; letter-spacing: -0.03em; margin: 6px 0 2px; }
  .xp-meta { font-size: 12px; color: var(--signal-ink); }
  .xp-company { color: var(--text-2); }
  .xp-text { color: var(--muted); font-size: 15px; margin-top: 8px; max-width: 58ch; }
  .xp-id { color: var(--muted); font-size: 12px; margin-top: 6px; overflow-wrap: anywhere; }
  @media (max-width: 860px) { .xp-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
