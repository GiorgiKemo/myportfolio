---
const forms = [
  { v: 'knot', l: 'Knot' },
  { v: 'torus', l: 'Torus' },
  { v: 'gem', l: 'Gem' },
  { v: 'sphere', l: 'Sphere' },
];
const mats = [
  { v: 'iridescent', l: 'Iridescent' },
  { v: 'glass', l: 'Glass' },
  { v: 'chrome', l: 'Chrome' },
  { v: 'clay', l: 'Clay' },
  { v: 'wire', l: 'Wireframe' },
];
---

<section id="lab" class="lab" aria-labelledby="lab-title" data-lab>
  <div class="wrap lab-grid">
    <div class="lab-copy">
      <p class="kicker">The lab · live WebGL</p>
      <h2 id="lab-title">Real-time 3D,<br /><span class="serif">right in the page.</span></h2>
      <p class="lab-text">
        Physically based materials, image-based lighting and custom shaders, rendered live by your own graphics card. Drag the object, then change its form and material.
      </p>

      <div class="lab-controls">
        <div class="lab-ctl">
          <span class="lab-lbl mono" id="lab-form">Form</span>
          <div class="seg" role="group" aria-labelledby="lab-form" data-lab-group="form">
            {forms.map((f, i) => <button type="button" data-value={f.v} aria-pressed={i === 0 ? 'true' : 'false'}>{f.l}</button>)}
          </div>
        </div>
        <div class="lab-ctl">
          <span class="lab-lbl mono" id="lab-mat">Material</span>
          <div class="seg" role="group" aria-labelledby="lab-mat" data-lab-group="mat">
            {mats.map((m, i) => <button type="button" data-value={m.v} aria-pressed={i === 0 ? 'true' : 'false'}>{m.l}</button>)}
          </div>
        </div>
      </div>
      <p class="lab-stats mono" data-lab-stats aria-live="polite"></p>
    </div>

    <div class="lab-stage">
      <canvas aria-label="Interactive 3D object. Drag to rotate." role="img" data-cursor="Drag"></canvas>
      <div class="lab-rings" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="lab-hint mono" aria-hidden="true">↻ drag to rotate</p>
      <p class="lab-fallback">This live 3D demo needs hardware-accelerated graphics, so here is a still frame instead.</p>
    </div>
  </div>
</section>

<style>
  .lab { padding: clamp(60px, 8vw, 110px) 0; }
  .lab-grid {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(24px, 4vw, 64px);
    padding: clamp(28px, 4vw, 56px); border-radius: calc(var(--radius) + 10px);
    background:
      radial-gradient(60% 80% at 80% 50%, color-mix(in oklab, var(--violet) 16%, transparent), transparent 70%),
      var(--bg-2);
    border: 1px solid var(--line);
  }
  .lab h2 { font-size: clamp(38px, 5vw, 80px); letter-spacing: -0.06em; line-height: 0.95; margin: 20px 0 22px; }
  .lab h2 .serif { color: var(--muted); }
  .lab-text { color: var(--text-2); max-width: 44ch; }
  .lab-controls { display: grid; gap: 18px; margin-top: 34px; }
  .lab-ctl { display: grid; gap: 8px; }
  .lab-lbl { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .seg { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); width: fit-content; }
  .seg button { border: 0; background: transparent; padding: 8px 14px; border-radius: 999px; font-size: 14px; color: var(--text-2); transition: background-color 0.3s, color 0.3s; }
  .seg button:hover { color: var(--text); }
  .seg button[aria-pressed='true'] { background: var(--text); color: var(--bg); }
  .lab-stats { margin-top: 22px; font-size: 12px; color: var(--muted); min-height: 1.4em; }

  .lab-stage { position: relative; aspect-ratio: 1 / 1; max-height: 640px; width: 100%; }
  .lab-stage canvas { position: relative; z-index: 1; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  :global(.is-dragging) .lab-stage canvas { cursor: grabbing; }
  .lab-rings { position: absolute; inset: 8%; display: grid; place-items: center; }
  .lab-rings i { position: absolute; border: 1px solid var(--line); border-radius: 50%; }
  .lab-rings i:nth-child(1) { inset: 0; }
  .lab-rings i:nth-child(2) { inset: 14%; border-style: dashed; animation: spin-r 40s linear infinite; }
  .lab-rings i:nth-child(3) { inset: 28%; }
  @keyframes spin-r { to { transform: rotate(360deg); } }
  .lab-hint { position: absolute; bottom: 4%; left: 50%; transform: translateX(-50%); font-size: 11px; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; }
  .lab-fallback { display: none; position: absolute; left: 10%; right: 10%; bottom: 10%; text-align: center; color: var(--muted); font-size: 14px; }
  :global(.no-webgl) .lab-fallback { display: block; }
  :global(.no-webgl) .lab-stage { background: url('/stills/lab-knot.webp') center / 82% no-repeat; background-blend-mode: normal; }
  :global([data-theme='dark']) :global(.no-webgl) .lab-stage { mix-blend-mode: lighten; }
  :global([data-theme='light']) :global(.no-webgl) .lab-stage { background-image: none; }
  :global(.no-webgl) .lab-controls, :global(.no-webgl) .lab-hint { display: none; }

  @media (max-width: 900px) { .lab-grid { grid-template-columns: 1fr; } .lab-stage { max-height: 520px; } }
</style>
