---
import { projects, previewSources, kindOf } from '../../data/projects';

const featured = projects.slice(0, 6);
const rest = projects;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="wrap work-head">
    <p class="kicker">Selected work · {pad(featured.length)}</p>
    <h2 id="work-title" class="work-title">
      Things I've <span class="serif">shipped</span>
    </h2>
    <p class="work-intro">Production platforms, company sites and experiments, ordered by how much engineering went into them.</p>
  </div>

  <div class="rail" data-rail>
    <ol class="rail-track" data-rail-track>
      {featured.map((p, i) => {
        const img = previewSources(p);
        return (
          <li class="card">
            <a href={`/work/${p.slug}/`} class="card-link" data-cursor="View">
              <div class="card-media">
                <img
                  src={img.src}
                  srcset={img.srcset}
                  sizes="(max-width: 760px) 92vw, 56vw"
                  width={img.width}
                  height={img.height}
                  alt={`${p.title} website preview`}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="card-body">
                <span class="card-n mono">{pad(i + 1)}</span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.description}</p>
                </div>
                <ul class="card-tags">
                  {p.tags.slice(0, 4).map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </a>
          </li>
        );
      })}
      <li class="card card-more">
        <a href="/work/" class="card-more-link" data-cursor="All">
          <span class="mono">+{rest.length - featured.length} more</span>
          <span class="card-more-title">See the full<br /><span class="serif">index</span> →</span>
        </a>
      </li>
    </ol>
  </div>

  <div class="wrap index" data-index>
    <div class="index-head">
      <h3 class="index-title">Project index</h3>
      <span class="mono index-count">{pad(rest.length)} entries</span>
    </div>
    <ul class="index-list">
      {rest.map((p, i) => {
        const img = previewSources(p);
        return (
          <li>
            <a class="row" href={`/work/${p.slug}/`} data-preview={img.src}>
              <span class="row-n mono">{pad(i + 1)}</span>
              <span class="row-title">{p.title}</span>
              <span class="row-kind">{kindOf(p)}</span>
              <span class="row-tags mono">{p.tags.slice(0, 3).join(' · ')}</span>
              <span class="row-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ul>
    <div class="index-float" data-index-float aria-hidden="true"><img alt="" /></div>
  </div>
</section>

<style>
  .work { padding: clamp(80px, 10vw, 140px) 0 0; }
  .work-head { display: grid; grid-template-columns: 1fr auto; gap: 18px 40px; align-items: end; margin-bottom: clamp(40px, 6vw, 72px); }
  .work-head .kicker { grid-column: 1 / -1; }
  .work-title { font-size: clamp(56px, 11vw, 190px); letter-spacing: -0.07em; line-height: 0.96; }
  .work-title .serif { color: var(--muted); letter-spacing: -0.04em; }
  .work-intro { max-width: 300px; color: var(--muted); font-size: 15px; padding-bottom: 12px; }

  /* horizontal rail (pinned + scrubbed on wide screens by JS) */
  .rail { overflow: hidden; }
  .rail-track {
    list-style: none; margin: 0; padding: 0 var(--gutter);
    display: flex; gap: clamp(16px, 2vw, 28px); width: max-content;
    will-change: transform;
  }
  .card { width: min(58vw, 880px); flex-shrink: 0; }
  .card-link { display: block; }
  .card-media {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius);
    background: var(--bg-3); box-shadow: var(--glow);
  }
  .card-media img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transform: scale(1.04); transition: transform 1.2s var(--ease), filter 0.8s; }
  .card-link:hover .card-media img { transform: scale(1.1); }
  .card-media::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.35), transparent 40%);
  }
  .card-body { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; padding: 22px 4px 0; }
  .card-n { font-size: 12px; color: var(--signal-ink); padding-top: 8px; }
  .card-body h3 { font-size: clamp(26px, 2.6vw, 40px); letter-spacing: -0.045em; }
  .card-body p { color: var(--muted); font-size: 15px; margin-top: 10px; max-width: 60ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-tags { grid-column: 2; list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .card-tags li { font-family: var(--font-mono); font-size: 11px; padding: 5px 10px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--text-2); }

  .card-more { width: min(34vw, 460px); }
  .card-more-link {
    height: 100%; min-height: 320px; aspect-ratio: auto; display: flex; flex-direction: column; justify-content: space-between;
    padding: 32px; border-radius: var(--radius); border: 1px dashed var(--line-2);
    transition: background-color 0.5s var(--ease), color 0.5s, border-color 0.5s;
  }
  .card-more-link .mono { font-size: 12px; color: var(--muted); }
  .card-more-title { font-size: clamp(36px, 4vw, 64px); font-weight: 600; letter-spacing: -0.055em; line-height: 0.95; }
  .card-more-link:hover { background: var(--signal); color: var(--on-signal); border-color: var(--signal); }
  .card-more-link:hover .mono { color: inherit; }

  /* index */
  .index { position: relative; padding: clamp(96px, 12vw, 180px) 0 0; }
  .index-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 18px; border-bottom: 1px solid var(--line-2); }
  .index-title { font-size: clamp(22px, 2.4vw, 32px); letter-spacing: -0.03em; }
  .index-count { font-size: 12px; color: var(--muted); }
  .index-list { list-style: none; margin: 0; padding: 0; }
  .row {
    position: relative; display: grid; grid-template-columns: 56px minmax(0, 1.4fr) minmax(0, 0.7fr) minmax(0, 1fr) 24px; gap: 20px; align-items: center;
    padding: 22px 0; border-bottom: 1px solid var(--line);
    transition: color 0.3s, padding 0.5s var(--ease);
  }
  .row::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--surface-2);
    transform: scaleY(0); transform-origin: bottom; transition: transform 0.5s var(--ease);
  }
  .row:hover::before { transform: scaleY(1); }
  .row:hover { padding-inline: 14px; }
  .row-n { font-size: 12px; color: var(--muted); }
  .row-title { font-size: clamp(20px, 2.2vw, 30px); font-weight: 560; letter-spacing: -0.035em; }
  .row-kind { color: var(--text-2); font-size: 15px; }
  .row-tags { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row-arrow { transition: transform 0.5s var(--ease); }
  .row:hover .row-arrow { transform: translateX(6px); color: var(--signal-ink); }

  .index-float {
    position: fixed; left: 0; top: 0; z-index: 50; width: 340px; aspect-ratio: 16 / 10; pointer-events: none;
    border-radius: 14px; overflow: hidden; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    opacity: 0; transform: translate3d(-50%, -50%, 0) scale(0.6); transition: opacity 0.35s var(--ease), scale 0.5s var(--ease);
  }
  .index-float img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .index-float.is-on { opacity: 1; scale: 1; }

  @media (max-width: 900px) {
    .work-head { grid-template-columns: 1fr; }
    .rail { overflow: visible; }
    .rail-track { flex-direction: column; width: auto; padding: 0 var(--gutter); gap: 56px; transform: none !important; }
    .card, .card-more { width: 100%; }
    .card-more-link { min-height: 220px; }
    .row { grid-template-columns: 36px 1fr 20px; gap: 12px; }
    .row-kind, .row-tags { display: none; }
    .index-float { display: none; }
  }
</style>
