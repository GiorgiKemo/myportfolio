---
import { site } from '../../data/site';

const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'WhatsApp', value: site.phone, href: site.links.whatsapp, ext: true },
  { label: 'Telegram', value: '@GiorgiKemo', href: site.links.telegram, ext: true },
  { label: 'Phone', value: site.phone, href: `tel:${site.phone.replace(/\s/g, '')}` },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="kicker">Contact</p>
    <h2 id="contact-title" class="contact-title">
      Let's build something <span class="serif spectrum-text">remarkable.</span>
    </h2>

    <div class="contact-grid">
      <div class="channels">
        {channels.map((c) => (
          <a class="channel" href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener noreferrer' : undefined}>
            <span class="mono">{c.label}</span>
            <strong>{c.value}</strong>
            <span class="ch-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
        <p class="where mono"><i aria-hidden="true"></i>{site.location} · <span data-clock>--:--</span> local time</p>
      </div>

      <form class="form" data-contact-form novalidate>
        <div class="field">
          <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder=" " />
          <label for="cf-name">Your name</label>
        </div>
        <div class="field">
          <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder=" " />
          <label for="cf-email">Email</label>
        </div>
        <div class="field">
          <input id="cf-subject" name="subject" type="text" required placeholder=" " />
          <label for="cf-subject">Subject</label>
        </div>
        <div class="field">
          <textarea id="cf-message" name="message" rows="5" required placeholder=" "></textarea>
          <label for="cf-message">Tell me about the project</label>
        </div>
        <div class="form-foot">
          <button class="btn btn-signal" type="submit" data-magnetic>
            <span data-submit-label>Send message</span> <span class="arrow" aria-hidden="true">↗</span>
          </button>
          <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </div>
        <p class="form-alt">Prefer email? <a class="link-underline" href={`mailto:${site.email}?subject=Project%20inquiry`}>Write to {site.email}</a></p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact { padding: clamp(110px, 14vw, 200px) 0 clamp(80px, 10vw, 140px); }
  .contact-title { font-size: clamp(52px, 9.6vw, 170px); letter-spacing: -0.07em; line-height: 0.86; margin: 24px 0 clamp(48px, 7vw, 96px); max-width: 12ch; }
  .contact-title .serif { letter-spacing: -0.035em; padding-right: 0.08em; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 7vw, 110px); align-items: start; }

  .channels { display: grid; border-top: 1px solid var(--line-2); }
  .channel {
    display: grid; grid-template-columns: 110px 1fr auto; gap: 16px; align-items: baseline;
    padding: 22px 0; border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease), color 0.3s;
  }
  .channel:hover { padding-left: 12px; color: var(--signal-ink); }
  .channel .mono { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .channel strong { font-size: clamp(18px, 1.8vw, 24px); font-weight: 540; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .where { display: flex; align-items: center; gap: 10px; margin-top: 22px; font-size: 12px; color: var(--muted); }
  .where i { width: 6px; height: 6px; border-radius: 50%; background: #3dff8a; box-shadow: 0 0 8px #3dff8a; }

  .form { display: grid; gap: 14px; }
  .field { position: relative; }
  .field input, .field textarea {
    width: 100%; padding: 26px 18px 12px; border-radius: 14px;
    border: 1px solid var(--line-2); background: var(--surface);
    font-size: 16px; outline: none; resize: vertical;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .field textarea { min-height: 160px; }
  .field input:focus, .field textarea:focus { border-color: var(--signal-ink); background: var(--surface-2); }
  .field label {
    position: absolute; left: 19px; top: 19px; color: var(--muted); font-size: 16px; pointer-events: none;
    transform-origin: left top; transition: transform 0.35s var(--ease), color 0.3s;
  }
  .field input:focus + label, .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label, .field textarea:not(:placeholder-shown) + label { transform: translateY(-11px) scale(0.74); color: var(--signal-ink); }
  .field.is-invalid input, .field.is-invalid textarea { border-color: var(--rose); }
  .form-foot { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 6px; }
  .form-status { font-size: 14px; color: var(--text-2); }
  .form-status.ok { color: #3dff8a; }
  :global([data-theme='light']) .form-status.ok { color: #0a7a3a; }
  .form-status.err { color: var(--rose); }
  .form-alt { font-size: 14px; color: var(--muted); }

  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } .channel { grid-template-columns: 90px 1fr auto; } }
</style>
