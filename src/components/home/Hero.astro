---
import { site } from '../../data/site';
const lines = [
  ['I', 'design', '&', 'build'],
  ['digital', 'products'],
  ['that', '<em>feel</em>', 'alive.'],
];
---

<script is:inline>
  // Start the headline reveal as soon as the first frame paints, without waiting for bundles.
  requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.classList.add('is-loaded')));
</script>

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-fallback"></div>
    <canvas class="hero-canvas" data-hero-canvas></canvas>
    <div class="hero-vignette"></div>
  </div>

  <div class="wrap hero-inner">
    <div class="hero-top">
      <p class="kicker hero-fade">Giorgi Kemoklidze · Full-stack developer</p>
      <p class="hero-coords mono hero-fade" aria-hidden="true">41.7151° N<br />44.8271° E</p>
    </div>

    <h1 id="hero-title" class="hero-title">
      <span class="sr-only">Giorgi Kemoklidze, full-stack developer. I design and build digital products that feel alive.</span>
      <span aria-hidden="true">
        {lines.map((words, li) => (
          <span class={`hl hl-${li + 1}`}>
            {words.map((w) => (
              <span class="hw"><span class="hw-in" set:html={w.replace('<em>', '<em class="serif">')} /></span>
            ))}
          </span>
        ))}
      </span>
    </h1>

    <div class="hero-bottom">
      <p class="hero-lede hero-fade">
        Production websites, AI tools, business dashboards and Supabase-backed apps, taken from first idea to launch, with the craft of a
        design studio and the rigour of an engineer.
      </p>
      <div class="hero-cta hero-fade">
        <a class="btn btn-signal" href="#work" data-magnetic>See the work <span class="arrow" aria-hidden="true">↓</span></a>
        <a class="btn btn-ghost" href="#contact" data-magnetic>Start a project</a>
      </div>
      <div class="hero-meta mono hero-fade">
        <span><i class="dot" aria-hidden="true"></i>{site.location}</span>
        <span>Scroll to explore</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; overflow: hidden; isolation: isolate; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-fallback {
    position: absolute; inset: 0;
    background:
      radial-gradient(40% 50% at 72% 45%, color-mix(in oklab, var(--violet) 40%, transparent), transparent 70%),
      radial-gradient(30% 40% at 80% 60%, color-mix(in oklab, var(--cyan) 30%, transparent), transparent 70%),
      radial-gradient(22% 28% at 66% 30%, color-mix(in oklab, var(--signal) 22%, transparent), transparent 70%);
    filter: blur(20px);
    transition: opacity 1.2s var(--ease);
  }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s var(--ease); }
  .hero-canvas:global(.is-ready) { opacity: 1; }
  .hero-bg:has(:global(.is-ready)) .hero-fallback { opacity: 0; }
  .hero-vignette {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to bottom, transparent 55%, var(--bg)), radial-gradient(120% 80% at 50% 50%, transparent 60%, var(--bg));
  }

  .hero-inner { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 128px 0 36px; min-height: 100svh; }
  .hero-top { display: flex; justify-content: space-between; align-items: start; gap: 20px; }
  .hero-coords { font-size: 11px; line-height: 1.6; color: var(--muted); text-align: right; letter-spacing: 0.08em; }

  .hero-title {
    font-size: clamp(52px, 10.4vw, 178px);
    font-weight: 620; letter-spacing: -0.065em; line-height: 0.88;
    margin: 48px 0 40px;
  }
  .hl { display: block; white-space: nowrap; }
  .hl-2 { padding-left: 0.9em; }
  .hl-3 { padding-left: 0.3em; }
  .hw { display: inline-block; overflow: hidden; vertical-align: top; padding: 0.02em 0.08em 0.1em 0; margin-right: 0.12em; }
  .hw-in { display: inline-block; transform: translateY(110%); will-change: transform; }
  .hw-in :global(em) { font-size: 1.1em; line-height: 0.8; letter-spacing: -0.03em; padding-right: 0.06em; }
  .hl-3 .hw:nth-child(2) .hw-in { background: var(--spectrum); -webkit-background-clip: text; background-clip: text; color: transparent; }
  :global(.no-js) .hw-in, :global(.is-loaded) .hw-in { transform: none; }
  :global(.is-loaded) .hw-in { transition: transform 1.3s var(--ease); }
  :global(.is-loaded) .hl-1 .hw:nth-child(2) .hw-in { transition-delay: 0.06s; }
  :global(.is-loaded) .hl-1 .hw:nth-child(3) .hw-in { transition-delay: 0.1s; }
  :global(.is-loaded) .hl-1 .hw:nth-child(4) .hw-in { transition-delay: 0.14s; }
  :global(.is-loaded) .hl-2 .hw:nth-child(1) .hw-in { transition-delay: 0.18s; }
  :global(.is-loaded) .hl-2 .hw:nth-child(2) .hw-in { transition-delay: 0.23s; }
  :global(.is-loaded) .hl-3 .hw:nth-child(1) .hw-in { transition-delay: 0.3s; }
  :global(.is-loaded) .hl-3 .hw:nth-child(2) .hw-in { transition-delay: 0.36s; }
  :global(.is-loaded) .hl-3 .hw:nth-child(3) .hw-in { transition-delay: 0.42s; }

  .hero-fade { opacity: 0; transform: translateY(14px); }
  :global(.no-js) .hero-fade, :global(.is-loaded) .hero-fade { opacity: 1; transform: none; }
  :global(.is-loaded) .hero-fade { transition: opacity 0.9s var(--ease) 0.2s, transform 0.9s var(--ease) 0.2s; }

  .hero-bottom { display: grid; grid-template-columns: minmax(0, 1.1fr) auto minmax(0, 0.7fr); gap: 32px; align-items: end; }
  .hero-lede { max-width: 440px; color: var(--text-2); font-size: 17px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-meta { display: flex; flex-direction: column; align-items: end; gap: 6px; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .hero-meta span { display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: #3dff8a; box-shadow: 0 0 10px #3dff8a; }

  @media (max-width: 980px) {
    .hero-bottom { grid-template-columns: 1fr; gap: 24px; }
    .hero-meta { align-items: start; flex-direction: row; gap: 20px; }
  }
  @media (max-width: 640px) {
    .hero-title { font-size: clamp(44px, 13.4vw, 80px); margin: 32px 0 28px; }
    .hl { white-space: normal; }
    .hl-2, .hl-3 { padding-left: 0; }
    .hero-coords { display: none; }
  }
</style>
