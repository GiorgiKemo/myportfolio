---
import { site } from '../../data/site';
import { guides } from '../../data/guides';

const picks = [
  { href: '/affiliate/verpex-hosting-review.html', icon: '🖥️', cat: 'Hosting', title: 'Verpex hosting review: plans, renewals & who it fits', tool: 'Plan picker + 3-year cost calculator' },
  { href: '/affiliate/sitemind-cost-calculator.html', icon: '🧮', cat: 'AI assistants', title: 'SiteMind cost calculator: which plan fits your traffic?', tool: 'Interactive break-even calculator' },
  { href: '/affiliate/onehomeschool-review.html', icon: '📚', cat: 'Homeschool', title: 'OneHomeschool: a planner that works with your curriculum', tool: 'Plan picker by number of kids' },
];
---

<section id="resources" class="res" aria-labelledby="res-title">
  <div class="wrap">
    <div class="res-card" data-anchor-land>
      <div class="res-copy">
        <p class="kicker">The Field Guide</p>
        <h2 id="res-title">Pick the right tools.<br /><span class="serif">Skip the regret.</span></h2>
        <p>Independent guides and interactive calculators on hosting, AI assistants, small-business tools and creator workflows, with real prices and honest "who it's not for" notes.</p>
        <a class="btn btn-signal" href={site.resourcesHref} data-hub-placement="home_resources" data-magnetic>Browse all {guides.length} guides <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <ul class="res-list">
        {picks.map((p) => (
          <li>
            <a href={p.href} class="res-item">
              <span class="res-ico" aria-hidden="true">{p.icon}</span>
              <span class="res-txt">
                <small class="mono">{p.cat}</small>
                <strong>{p.title}</strong>
                <span>{p.tool}</span>
              </span>
              <span class="res-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .res { padding: clamp(40px, 6vw, 80px) 0; }
  .res-card {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 5vw, 72px); align-items: center;
    padding: clamp(28px, 5vw, 64px); border-radius: calc(var(--radius) + 10px);
    background: var(--bg-2); border: 1px solid var(--line);
  }
  .res-card::before {
    content: ''; position: absolute; width: 520px; height: 520px; right: -160px; top: -220px; border-radius: 50%;
    background: conic-gradient(from 90deg, var(--violet), var(--cyan), var(--signal), var(--violet)); filter: blur(90px); opacity: 0.22;
    animation: drift 18s linear infinite;
  }
  @keyframes drift { to { transform: rotate(360deg); } }
  .res-copy { position: relative; display: grid; gap: 20px; justify-items: start; }
  .res-copy h2 { font-size: clamp(36px, 4.6vw, 72px); letter-spacing: -0.06em; line-height: 0.94; }
  .res-copy .serif { color: var(--muted); }
  .res-copy p { color: var(--text-2); max-width: 46ch; }
  .res-list { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .res-item {
    display: grid; grid-template-columns: 52px 1fr auto; gap: 16px; align-items: center;
    padding: 16px 18px; border-radius: 16px; background: var(--bg); border: 1px solid var(--line);
    transition: transform 0.5s var(--ease), border-color 0.3s;
  }
  .res-item:hover { transform: translateX(8px); border-color: var(--signal-ink); }
  .res-ico { width: 52px; height: 52px; border-radius: 12px; display: grid; place-items: center; font-size: 24px; background: var(--surface-2); }
  .res-txt { display: grid; gap: 2px; }
  .res-txt small { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .res-txt strong { font-weight: 560; letter-spacing: -0.02em; line-height: 1.3; }
  .res-txt span { font-size: 13.5px; color: var(--muted); }
  .res-arrow { transition: transform 0.4s var(--ease); }
  .res-item:hover .res-arrow { transform: translate(3px, -3px); color: var(--signal-ink); }
  @media (max-width: 900px) { .res-card { grid-template-columns: 1fr; } }
</style>
