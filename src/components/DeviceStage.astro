---
// A project shown in a browser window with a phone overlapping its bottom-right corner.
// At rest both screens show the top of the page. On hover/focus (or when the card is in view on
// touch screens) the full-height page loads and scrolls through, desktop and phone together.
// Assets come from scripts/build-device-cards.mjs. Projects without them fall back to the
// regular preview image.
import cards from '../data/deviceCards.json';
import { previewSources, type Project } from '../data/projects';

interface Props {
  project: Project;
  sizes: string;
  eager?: boolean;
}
const { project: p, sizes, eager = false } = Astro.props;
type Screen = { full: boolean; ratio: number };
type Entry = { desktop?: Screen; mobile?: Screen; tint?: string; statusBg?: string; statusInk?: string };
const c = (cards as Record<string, Entry>)[p.slug];
const dir = '/project-previews/cards';
const img = previewSources(p);
const host = p.liveLink ? new URL(p.liveLink).host.replace(/^www\./, '') : p.title.toLowerCase().replace(/\s+/g, '') + '.app';
const loading = eager ? 'eager' : 'lazy';

// Seconds to scroll through a page: about 2.2s per extra screen, within sensible bounds.
const duration = (s: Screen | undefined, screenRatio: number) =>
  s?.full ? Math.min(16, Math.max(3, (s.ratio / screenRatio - 1) * 2.2)).toFixed(1) + 's' : '0s';
const style = c
  ? [
      `--tint:${c.tint ?? '#222'}`,
      `--dur-d:${duration(c.desktop, 900 / 1440)}`,
      `--dur-m:${duration(c.mobile, 844 / 390)}`,
      c.statusBg ? `--status-bg:${c.statusBg}` : '',
    ].filter(Boolean).join(';')
  : undefined;
---

{c?.desktop ? (
  <div class:list={['ds', { 'ds-solo': !c.mobile }]} style={style} data-device-stage>
    <div class="ds-browser">
      <div class="ds-bar" aria-hidden="true">
        <i></i><i></i><i></i>
        <span class="ds-url mono">{host}</span>
      </div>
      <div class="ds-screen">
        <img
          class="ds-shot"
          src={`${dir}/${p.slug}-d-poster-720.webp`}
          srcset={`${dir}/${p.slug}-d-poster-720.webp 720w, ${dir}/${p.slug}-d-poster-1440.webp 1440w`}
          sizes={sizes}
          width="1440"
          height="900"
          alt={`${p.title} on a desktop browser`}
          loading={loading}
          decoding="async"
          data-full={c.desktop.full ? `${dir}/${p.slug}-d-full.webp` : undefined}
        />
      </div>
    </div>
    {c.mobile && (
      <div class="ds-phone">
        <div class="ds-phone-screen">
          <div class="ds-phone-view">
          <img
            class="ds-shot ds-shot-m"
            src={`${dir}/${p.slug}-m-poster.webp`}
            width="420"
            height="909"
            alt={`${p.title} on a phone`}
            loading={loading}
            decoding="async"
            data-full={c.mobile.full ? `${dir}/${p.slug}-m-full.webp` : undefined}
          />
          </div>
        </div>
        <span class="ds-island" aria-hidden="true"></span>
      </div>
    )}
  </div>
) : (
  <img
    class="ds-fallback"
    src={img.src}
    srcset={img.srcset}
    sizes={sizes}
    width={img.width}
    height={img.height}
    style={img.style}
    alt={`${p.title} preview`}
    loading={loading}
    decoding="async"
  />
)}

<script>
  // Loads the tall screenshots only when someone shows interest, then lets CSS scroll them.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const coarse = matchMedia('(hover: none), (pointer: coarse)');

  const loadFull = (stage: HTMLElement) => {
    if (reduced.matches || stage.dataset.loaded) return;
    stage.dataset.loaded = '1';
    stage.querySelectorAll<HTMLImageElement>('img[data-full]').forEach((img) => {
      const next = new Image();
      next.decoding = 'async';
      next.src = img.dataset.full!;
      next.decode().then(() => {
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        img.removeAttribute('height');
        img.src = next.src;
        // Next frame, so the swap paints at the top before the scroll transition starts.
        requestAnimationFrame(() => img.classList.add('is-full'));
      }).catch(() => { delete stage.dataset.loaded; });
    });
  };

  const stages = [...document.querySelectorAll<HTMLElement>('[data-device-stage]')];
  stages.forEach((stage) => {
    const host = stage.closest('a') ?? stage;
    host.addEventListener('pointerenter', () => loadFull(stage));
    host.addEventListener('focusin', () => loadFull(stage));
  });

  // Touch screens have no hover: play each card while it sits well inside the viewport.
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (!coarse.matches || reduced.matches) return;
      entries.forEach((e) => {
        const stage = e.target as HTMLElement;
        if (e.intersectionRatio >= 0.75) {
          loadFull(stage);
          stage.classList.add('is-playing');
        } else if (e.intersectionRatio < 0.3) {
          stage.classList.remove('is-playing');
        }
      });
    }, { threshold: [0, 0.3, 0.75, 1] });
    stages.forEach((s) => io.observe(s));
  }
</script>

<style>
  .ds {
    --frame: #1b1b21;
    position: relative; aspect-ratio: 16 / 10; width: 100%; overflow: hidden;
    container-type: inline-size;
    background:
      radial-gradient(90% 80% at 18% 0%, color-mix(in oklab, var(--tint) 55%, transparent), transparent 70%),
      radial-gradient(60% 70% at 100% 100%, color-mix(in oklab, var(--tint) 30%, transparent), transparent 70%),
      linear-gradient(160deg, color-mix(in oklab, var(--tint) 22%, var(--bg-2)), var(--bg-2));
  }
  :global([data-theme='light']) .ds { --frame: #24242b; }

  /* Browser window: 80cqw wide, a 1440x900 (16:10) screen under a slim toolbar. */
  .ds-browser {
    position: absolute; left: 5cqw; top: 5.4cqw; width: 80cqw;
    border-radius: 1.2cqw; overflow: hidden; background: var(--frame);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 2.4cqw 6cqw -1.6cqw rgba(0, 0, 0, 0.55);
    transition: transform 0.9s var(--ease);
  }
  .ds-solo .ds-browser { left: 7cqw; width: 86cqw; top: 4.5cqw; }
  .ds-bar { display: flex; align-items: center; gap: 0.6cqw; height: max(12px, 2.8cqw); padding: 0 1.2cqw; }
  .ds-bar i { width: 0.75cqw; height: 0.75cqw; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
  .ds-bar i:first-child { background: #ff5f57; }
  .ds-bar i:nth-child(2) { background: #febc2e; }
  .ds-bar i:nth-child(3) { background: #28c840; }
  .ds-url {
    margin: 0 auto; transform: translateX(-1.6cqw); padding: 0.3cqw 2.4cqw; border-radius: 0.6cqw;
    background: rgba(255, 255, 255, 0.07); color: rgba(255, 255, 255, 0.62); font-size: max(7px, 1.15cqw); line-height: 1.2;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 50%;
  }
  .ds-screen { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #fff; container-type: size; }

  /* Phone: 19cqw wide, overlapping the browser's bottom-right corner. */
  .ds-phone {
    position: absolute; right: 4cqw; bottom: 3.2cqw; width: 19cqw; padding: 0.85cqw;
    border-radius: 3.4cqw; background: var(--frame);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12), inset 0 0 0 0.25cqw #2c2c33, -1.6cqw 2.4cqw 5cqw -1cqw rgba(0, 0, 0, 0.6);
    transition: transform 0.9s var(--ease);
  }
  .ds-phone-screen {
    position: relative; overflow: hidden; border-radius: 2.6cqw;
    padding-top: 3.4cqw; background: var(--status-bg, #fff);
  }
  .ds-phone-view { position: relative; aspect-ratio: 390 / 844; overflow: hidden; container-type: size; }
  .ds-island {
    position: absolute; top: 1.5cqw; left: 50%; width: 5.2cqw; height: 1.5cqw; translate: -50% 0;
    border-radius: 1cqw; background: #000;
  }

  .ds-fallback { display: block; width: 100%; height: auto; }
  .ds-shot {
    display: block; width: 100%; height: auto; max-width: none;
    transform: translate3d(0, 0, 0);
    transition: transform 1.1s var(--ease);
  }

  /* Scroll from the top of the page to the bottom (100cqh = one screen). */
  :global(a:hover) .ds-shot.is-full,
  :global(a:focus-visible) .ds-shot.is-full,
  .ds.is-playing .ds-shot.is-full {
    transform: translate3d(0, calc(-100% + 100cqh), 0);
    transition: transform var(--dur-d) cubic-bezier(0.45, 0.05, 0.4, 1) 0.2s;
  }
  :global(a:hover) .ds-shot-m.is-full,
  :global(a:focus-visible) .ds-shot-m.is-full,
  .ds.is-playing .ds-shot-m.is-full { transition-duration: var(--dur-m); transition-delay: 0.45s; }
  :global(a:hover) .ds-phone, .ds.is-playing .ds-phone { transform: translate3d(0, -1.2cqw, 0) rotate(-1deg); }
  :global(a:hover) .ds-browser, .ds.is-playing .ds-browser { transform: translate3d(0, -0.4cqw, 0); }

  @media (prefers-reduced-motion: reduce) {
    .ds-shot, .ds-phone, .ds-browser { transition: none !important; transform: none !important; }
  }
</style>
