---
import { site } from '../data/site';
interface Props { cta?: boolean; }
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="sf">
  <div class="wrap">
    {cta && (
    <div class="sf-top">
      <p class="sf-big">Have an idea<br /><span class="serif">worth building?</span></p>
      <a class="sf-mail" href={`mailto:${site.email}?subject=Project%20inquiry`} data-cursor="Write">
        {site.email}<span aria-hidden="true">↗</span>
      </a>
    </div>
    )}

    <div class="sf-grid">
      <div>
        <h2 class="sf-h mono">Site</h2>
        <ul>
          <li><a class="link-underline" href="/#work">Selected work</a></li>
          <li><a class="link-underline" href="/work/">Project index</a></li>
          <li><a class="link-underline" href="/#services">Services</a></li>
          <li><a class="link-underline" href="/offers/conversion-snapshot.html">Conversion Snapshot</a></li>
        </ul>
      </div>
      <div>
        <h2 class="sf-h mono">Resources</h2>
        <ul>
          <li><a class="link-underline" href={site.resourcesHref} data-hub-placement="footer">The Field Guide</a></li>
          <li><a class="link-underline" href="/affiliate/verpex-hosting-review.html">Hosting review</a></li>
          <li><a class="link-underline" href="/affiliate/sitemind-cost-calculator.html">AI assistant calculator</a></li>
          <li><a class="link-underline" href="/affiliate/onehomeschool-review.html">Homeschool planner</a></li>
        </ul>
      </div>
      <div>
        <h2 class="sf-h mono">Elsewhere</h2>
        <ul>
          <li><a class="link-underline" href={site.links.github} target="_blank" rel="noopener noreferrer me">GitHub</a></li>
          <li><a class="link-underline" href={site.links.linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn</a></li>
          <li><a class="link-underline" href={site.links.x} target="_blank" rel="noopener noreferrer me">X / Twitter</a></li>
          <li><a class="link-underline" href={site.links.telegram} target="_blank" rel="noopener noreferrer">Telegram</a></li>
        </ul>
      </div>
      <div>
        <h2 class="sf-h mono">Studio</h2>
        <p class="sf-p">{site.name}<br />Independent full-stack developer<br />{site.location}</p>
      </div>
    </div>

    <svg class="sf-word" viewBox="-4 0 884 212" aria-hidden="true" focusable="false">
      <text x="0" y="160">giorgi<tspan class="serif">.codes</tspan></text>
    </svg>

    <div class="sf-bottom mono">
      <span>© {year} {site.name}</span>
      <span>Affiliate links on this site are always labelled.</span>
      <a href="#main" class="link-underline">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .sf { position: relative; border-top: 1px solid var(--line); padding: clamp(72px, 10vw, 140px) 0 28px; overflow: hidden; }
  .sf-top { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; padding-bottom: 64px; border-bottom: 1px solid var(--line); }
  .sf-big { font-size: clamp(40px, 6vw, 88px); font-weight: 600; letter-spacing: -0.05em; line-height: 0.98; }
  .sf-big .serif { color: var(--muted); }
  .sf-mail {
    display: inline-flex; gap: 12px; align-items: center;
    font-size: clamp(20px, 2.4vw, 30px); letter-spacing: -0.02em;
    padding-bottom: 6px; border-bottom: 1px solid var(--line-2); transition: border-color 0.3s, color 0.3s;
  }
  .sf-mail:hover { color: var(--signal-ink); border-color: var(--signal-ink); }
  .sf-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; padding: 56px 0; }
  .sf-top + .sf-grid { padding-top: 56px; }
  .sf-grid:first-child { padding-top: 0; }
  .sf-h { font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; }
  .sf-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .sf-grid a, .sf-p { color: var(--text-2); font-size: 15px; }
  .sf-grid a:hover { color: var(--text); }
  .sf-p { line-height: 1.7; }
  .sf-word { width: 100%; height: auto; margin: 0 0 28px; overflow: visible; user-select: none; }
  .sf-word text { font-family: var(--font-sans); font-size: 200px; font-weight: 700; letter-spacing: -14px; fill: none; stroke: var(--line-2); stroke-width: 1; }
  .sf-word .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -4px; fill: var(--surface-2); stroke: none; }
  .sf-bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--muted); }
  @media (max-width: 820px) { .sf-grid { grid-template-columns: 1fr 1fr; } }
</style>
