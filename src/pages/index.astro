---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import About from '../components/home/About.astro';
import Work from '../components/home/Work.astro';
import Experience from '../components/home/Experience.astro';
import Capabilities from '../components/home/Capabilities.astro';
import Lab from '../components/home/Lab.astro';
import Stack from '../components/home/Stack.astro';
import Services from '../components/home/Services.astro';
import Resources from '../components/home/Resources.astro';
import Contact from '../components/home/Contact.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { skills } from '../data/portfolioData.js';
import { credentials } from '../data/career';

const description =
  "Giorgi Kemoklidze is a full-stack web and mobile developer in Tbilisi, building websites, SaaS, AI tools and apps with React, Next.js, Flutter and React Native since 2024.";

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Giorgi Codes',
    url: `${site.url}/`,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.name,
    url: `${site.url}/`,
    image: `${site.url}/logo-gk.png`,
    jobTitle: site.role,
    email: `mailto:${site.email}`,
    address: { '@type': 'PostalAddress', addressLocality: 'Tbilisi', addressCountry: 'GE' },
    sameAs: [site.links.github, site.links.linkedin, site.links.x],
    knowsAbout: skills.map((s) => s.name),
    hasCredential: credentials.map((c) => ({
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Certificate',
      name: c.name,
      recognizedBy: { '@type': 'Organization', name: c.issuer },
      ...(c.id ? { identifier: c.id } : {}),
    })),
    founder: {
      '@type': 'SoftwareApplication',
      name: 'ResumeATS',
      url: 'https://www.resumeats.cv',
      applicationCategory: 'BusinessApplication',
    },
    creator: [
      {
        '@type': 'SoftwareApplication',
        name: 'ResumeATS',
        url: 'https://www.resumeats.cv',
        applicationCategory: 'BusinessApplication',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Selected projects',
    itemListElement: projects.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site.url}/work/${p.slug}/`,
      name: p.title,
      ...(p.liveLink ? { sameAs: p.liveLink } : {}),
    })),
  },
];
---

<Base title="Giorgi Kemoklidze · Full-Stack Developer & Designer" description={description} path="/" ogType="profile" jsonLd={jsonLd} footerCta={false}>
  <main id="main">
    <Hero />
    <Marquee items={['React', 'Next.js', 'React Native', 'Flutter', 'Three.js', 'TypeScript', 'Supabase', 'Astro', 'UX design', 'Stripe', 'WebGL', 'SEO', 'AI tools', 'PostgreSQL']} />
    <About />
    <Work />
    <Experience />
    <Capabilities />
    <Lab />
    <Stack />
    <Marquee reverse items={['Websites', 'Mobile apps', 'Dashboards', 'AI assistants', '3D explorers', 'Marketplaces', 'Automation', 'Landing pages', 'MCP servers']} />
    <Services />
    <Resources />
    <Contact />
  </main>
</Base>

<script>
  import '../scripts/home';
</script>
