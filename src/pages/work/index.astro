---
import Base from '../../layouts/Base.astro';
import { projects, previewSources, kindOf } from '../../data/projects';
import { site } from '../../data/site';

const kinds = ['All', ...new Set(projects.map(kindOf))];
const pad = (n: number) => String(n).padStart(2, '0');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Work by Giorgi Kemoklidze',
    url: `${site.url}/work/`,
    hasPart: projects.map((p) => ({ '@type': 'CreativeWork', name: p.title, url: `${site.url}/work/${p.slug}/` })),
  },
];
---

<Base
  title="Work · Every project by Giorgi Kemoklidze"
  description={`${projects.length} production websites, web apps, AI tools and 3D experiences designed and built by full-stack developer Giorgi Kemoklidze.`}
  path="/work/"
  jsonLd={jsonLd}
>
  <main id="main" class="wk">
    <header class="wrap wk-head">
      <p class="kicker">Project index · {pad(projects.length)}</p>
      <h1>All the <span class="serif">work.</span></h1>
      <div class="wk-filters" role="group" aria-label="Filter by type" data-filters>
        {kinds.map((k, i) => <button type="button" data-kind={k} aria-pressed={i === 0 ? 'true' : 'false'}>{k}</button>)}
      </div>
    </header>

    <ul class="wrap wk-grid" data-grid>
      {projects.map((p, i) => {
        const img = previewSources(p);
        return (
          <li class="wk-item reveal" data-kind={kindOf(p)} style={`transition-delay:${(i % 2) * 0.08}s`}>
            <a href={`/work/${p.slug}/`} data-cursor="View">
              <div class="wk-media">
                <img src={img.src} srcset={img.srcset} sizes="(max-width: 760px) 94vw, 46vw" width={img.width} height={img.height} alt={`${p.title} preview`} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              </div>
              <div class="wk-info">
                <span class="mono">{pad(i + 1)}</span>
                <h2>{p.title}</h2>
                <span class="wk-kind">{kindOf(p)}</span>
              </div>
              <p>{p.description}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</Base>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-grid] .wk-item')];
  wrap?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    wrap.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const k = b.dataset.kind;
    const apply = () => items.forEach((it) => { it.hidden = k !== 'All' && it.dataset.kind !== k; });
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(apply);
    else apply();
  });
</script>

<style>
  .wk { padding: 150px 0 clamp(80px, 10vw, 140px); }
  .wk-head { display: grid; gap: 26px; margin-bottom: clamp(48px, 6vw, 80px); }
  .wk-head h1 { font-size: clamp(56px, 12vw, 200px); letter-spacing: -0.07em; line-height: 0.85; }
  .wk-head .serif { color: var(--muted); }
  .wk-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .wk-filters button { padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line-2); background: transparent; font-size: 14px; color: var(--text-2); transition: all 0.3s; }
  .wk-filters button:hover { color: var(--text); border-color: var(--text); }
  .wk-filters button[aria-pressed='true'] { background: var(--signal); border-color: var(--signal); color: var(--on-signal); }
  .wk-grid { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 5vw, 72px) clamp(20px, 3vw, 40px); }
  .wk-item:nth-child(even) { margin-top: clamp(0px, 8vw, 120px); }
  .wk-item[hidden] { display: none; }
  .wk-media { aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius); background: var(--bg-3); box-shadow: var(--glow); }
  .wk-media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1.2s var(--ease); }
  .wk-item a:hover .wk-media img { transform: scale(1.06); }
  .wk-info { display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 14px; margin-top: 20px; }
  .wk-info .mono { font-size: 12px; color: var(--signal-ink); }
  .wk-info h2 { font-size: clamp(24px, 2.4vw, 34px); letter-spacing: -0.045em; }
  .wk-kind { font-size: 13px; color: var(--muted); }
  .wk-item p { color: var(--muted); font-size: 15px; margin-top: 8px; max-width: 58ch; }
  @media (max-width: 760px) { .wk-grid { grid-template-columns: 1fr; } .wk-item:nth-child(even) { margin-top: 0; } }
</style>
