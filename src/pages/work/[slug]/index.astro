---
import Base from '../../../layouts/Base.astro';
import { projects, previewSources, kindOf, type Project } from '../../../data/projects';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props { project: Project; index: number; next: Project }
const { project: p, index, next } = Astro.props;
const img = previewSources(p);
const nextImg = previewSources(next);
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const pad = (n: number) => String(n).padStart(2, '0');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: p.title,
    description: p.description,
    url: `${site.url}/work/${p.slug}/`,
    image: `${site.url}${p.previewImage}`,
    keywords: p.tags.join(', '),
    creator: { '@type': 'Person', '@id': `${site.url}/#person`, name: site.name },
    ...(p.liveLink ? { sameAs: p.liveLink } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Giorgi Codes', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work/` },
      { '@type': 'ListItem', position: 3, name: p.title, item: `${site.url}/work/${p.slug}/` },
    ],
  },
];
---

<Base
  title={`${p.title} · Case study by Giorgi Kemoklidze`}
  description={p.description}
  path={`/work/${p.slug}/`}
  ogImage={p.previewImage}
  ogImageAlt={`${p.title} website preview`}
  ogType="article"
  jsonLd={jsonLd}
>
  <main id="main" class="cs">
    <header class="wrap cs-head">
      <nav class="cs-crumbs mono" aria-label="Breadcrumb">
        <a href="/" class="link-underline">Home</a><span aria-hidden="true">/</span><a href="/work/" class="link-underline">Work</a><span aria-hidden="true">/</span><span>{pad(index + 1)}</span>
      </nav>
      <h1 class="cs-title">{p.title}</h1>
      <div class="cs-meta">
        <p class="cs-desc">{p.description}</p>
        <dl class="cs-facts">
          <div><dt class="mono">Type</dt><dd>{kindOf(p)}</dd></div>
          <div><dt class="mono">Role</dt><dd>Design &amp; development</dd></div>
          {p.liveLink && <div><dt class="mono">Live</dt><dd><a class="link-underline" href={p.liveLink} target="_blank" rel="noopener noreferrer">{host(p.liveLink)} ↗</a></dd></div>}
          <div><dt class="mono">Source</dt><dd>{p.githubLink ? <a class="link-underline" href={p.githubLink} target="_blank" rel="noopener noreferrer">GitHub ↗</a> : 'Private repository'}</dd></div>
        </dl>
      </div>
      <div class="cs-actions">
        {p.liveLink && (
          <a class="btn btn-signal" href={p.liveLink} target="_blank" rel="noopener noreferrer" data-magnetic>
            {p.liveLinkLabel ?? 'Visit live site'} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
        {p.githubLink && <a class="btn btn-ghost" href={p.githubLink} target="_blank" rel="noopener noreferrer">View code</a>}
      </div>
    </header>

    <figure class="wrap cs-shot">
      <div class="cs-frame" data-tilt>
        <div class="cs-bar" aria-hidden="true"><i></i><i></i><i></i><span class="mono">{p.liveLink ? host(p.liveLink) : p.slug}</span></div>
        <picture>
          <source type="image/webp" srcset={img.srcset} sizes="(max-width: 1320px) 94vw, 1240px" />
          <img src={img.fallback} width={img.width} height={img.height} alt={`${p.title} homepage screenshot`} fetchpriority="high" />
        </picture>
      </div>
    </figure>

    <section class="wrap cs-stack" aria-labelledby="stack-h">
      <h2 id="stack-h" class="kicker">Built with</h2>
      <ul>{p.tags.map((t) => <li>{t}</li>)}</ul>
    </section>

    <a class="cs-next" href={`/work/${next.slug}/`} data-cursor="Next">
      <div class="wrap cs-next-inner">
        <span class="mono">Next project</span>
        <span class="cs-next-title">{next.title}</span>
        <img src={nextImg.src} alt="" width={nextImg.width} height={nextImg.height} loading="lazy" />
      </div>
    </a>
  </main>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const frame = document.querySelector<HTMLElement>('[data-tilt]');
  if (frame && !reduced && matchMedia('(hover: hover)').matches) {
    frame.addEventListener('pointermove', (e) => {
      const r = frame.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      frame.style.transform = `perspective(1600px) rotateY(${x * 4}deg) rotateX(${-y * 4}deg)`;
    });
    frame.addEventListener('pointerleave', () => { frame.style.transform = ''; });
  }
</script>

<style>
  .cs { padding-top: 150px; }
  .cs-crumbs { display: flex; gap: 10px; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .cs-title { font-size: clamp(48px, 9vw, 150px); letter-spacing: -0.065em; line-height: 0.9; margin: 28px 0 40px; animation: rise 1.1s var(--ease) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); } }
  .cs-meta { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 6vw, 96px); padding-top: 28px; border-top: 1px solid var(--line-2); }
  .cs-desc { font-size: clamp(19px, 1.7vw, 24px); color: var(--text-2); line-height: 1.5; letter-spacing: -0.01em; }
  .cs-facts { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px 28px; }
  .cs-facts dt { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .cs-facts dd { margin: 0; }
  .cs-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 40px; }

  .cs-shot { margin: clamp(56px, 8vw, 96px) auto 0; }
  .cs-frame {
    border-radius: 18px; overflow: hidden; background: var(--bg-3); box-shadow: var(--glow), 0 60px 120px -60px color-mix(in oklab, var(--violet) 50%, transparent);
    transition: transform 0.8s var(--ease); animation: rise 1.2s var(--ease) 0.15s both;
  }
  .cs-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid var(--line); background: var(--bg-2); }
  .cs-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); }
  .cs-bar span { margin: 0 auto; font-size: 12px; color: var(--muted); padding: 4px 14px; border-radius: 8px; background: var(--surface-2); }
  .cs-frame img { width: 100%; }

  .cs-stack { padding: clamp(72px, 9vw, 120px) 0; display: grid; gap: 24px; }
  .cs-stack ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .cs-stack li { padding: 12px 20px; border-radius: 999px; border: 1px solid var(--line-2); font-size: clamp(17px, 1.6vw, 22px); letter-spacing: -0.02em; }

  .cs-next { display: block; border-top: 1px solid var(--line); overflow: hidden; }
  .cs-next-inner { position: relative; padding: clamp(64px, 10vw, 140px) 0; display: grid; gap: 14px; }
  .cs-next .mono { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .cs-next-title { font-size: clamp(44px, 8vw, 130px); font-weight: 600; letter-spacing: -0.065em; line-height: 0.92; transition: transform 0.8s var(--ease), color 0.4s; }
  .cs-next:hover .cs-next-title { transform: translateX(24px); color: var(--signal-ink); }
  .cs-next img {
    position: absolute; right: 0; top: 50%; width: min(36vw, 460px); border-radius: 14px; pointer-events: none;
    transform: translateY(-50%) rotate(6deg) scale(0.85); opacity: 0; transition: opacity 0.5s var(--ease), transform 0.8s var(--ease);
  }
  .cs-next:hover img { opacity: 1; transform: translateY(-50%) rotate(-3deg) scale(1); }

  @media (max-width: 860px) {
    .cs { padding-top: 120px; }
    .cs-meta { grid-template-columns: 1fr; }
    .cs-next img { display: none; }
  }
</style>
